# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.
#
# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Default matches the local Postgres from `docker-compose.yml`.
# For Neon, use the `*.neon.tech` connection string (the HTTP driver is selected
# automatically). For Supabase/self-hosted, the standard `node-postgres` driver
# is used. Override the driver explicitly with DB_DRIVER if needed.
POSTGRES_URL="postgres://postgres:password@localhost:5432/acme"

# Force a specific driver: "node" (node-postgres/TCP) or "neon-http".
# Leave empty to auto-detect from POSTGRES_URL.
# DB_DRIVER=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# App URL (used in emails and metadata)
APP_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME="Acme Inc."
NEXT_PUBLIC_APP_SHORT_NAME="Acme"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: point the web client at a standalone API server (apps/app-server).
# Leave empty to use the built-in Next.js route handler at /api/orpc.
# NEXT_PUBLIC_API_URL=http://localhost:7000

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -base64 32
# Leave empty here so a weak default is never shipped by accident.
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET=

# Preconfigured Google OAuth provider (optional)
# @see https://www.better-auth.com/docs/authentication/google
AUTH_GOOGLE_ID=''
AUTH_GOOGLE_SECRET=''

# -----------------------------------------------------------------------------
# Email (local sandbox via inbucket from docker-compose)
# -----------------------------------------------------------------------------
EMAIL_SANDBOX_ENABLED=true
EMAIL_SANDBOX_HOST=localhost
# RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Storage (S3 / local MinIO from docker-compose)
# -----------------------------------------------------------------------------
# AWS_S3_ENDPOINT=http://localhost:9002
# AWS_S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=minio
# AWS_SECRET_ACCESS_KEY=password
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=files.acme.com

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
# LOG_LEVEL=debug
# OTEL_EXPORTER_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------
# Hatchet (job queue / background workers)
# -----------------------------------------------------------------------------
# JWT token from the Hatchet dashboard → Settings → API Tokens.
# Required to run the worker process (packages/jobs).
# @see https://cloud.onhatchet.run
HATCHET_CLIENT_TOKEN=

# -----------------------------------------------------------------------------
# hh.ru scraper (packages/scraper + packages/jobs)
# -----------------------------------------------------------------------------
# Учётные данные аккаунта hh.ru для авторизации через playwright.
# Если не указаны — скрапинг выполняется анонимно (без cookie-сессии).
# HH_PHONE=9991234567
# HH_PASSWORD=your-password

# Путь к файлу с сохранёнными cookies после первой авторизации.
# Повторный логин не нужен пока сессия активна.
HH_COOKIES_PATH=./storage/hh-cookies.json

# Директория локального хранилища crawlee (очереди, датасеты, key-value).
CRAWLEE_STORAGE_DIR=./storage/crawlee

# Максимальное число параллельных браузерных страниц.
# Увеличивайте осторожно — высокий concurrency повышает риск блокировки.
HH_SCRAPER_CONCURRENCY=2

# Максимальное число страниц выдачи на один поисковый запрос (20 вакансий/стр).
# Скрапер сам останавливается, когда у hh.ru кончается кнопка "следующая
# страница" (обычно ~10-15 страниц на запрос), так что большое значение здесь
# просто снимает искусственный лимит и не заставляет реально проходить 50 стр.
HH_SCRAPER_MAX_PAGES=50

# Запускать браузер в фоновом режиме (true) или показывать окно (false).
# false удобен для отладки авторизации.
HH_SCRAPER_HEADLESS=true

# Cron-расписание автоматического запуска скрапера (формат: мин час д-м м д-н).
# По умолчанию: каждые 6 часов.
# @see https://crontab.guru
HH_SCRAPER_CRON="0 */6 * * *"

# -----------------------------------------------------------------------------
# LLM (OpenRouter) — генерация резюме и оценка соответствия (packages/ai)
# -----------------------------------------------------------------------------
# API-ключ OpenRouter. Получить: https://openrouter.ai/keys
# Требуется для resume.generate, match.compute/scorePair и воркфлоу
# generate-resume / score-resume-matches.
OPENROUTER_API_KEY=

# Базовый URL API OpenRouter (менять обычно не нужно).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Модель по умолчанию для скоринга и генерации.
# Список моделей: https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini
